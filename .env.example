# Copy to .env and fill in before running `docker compose up`.

# --- required ---------------------------------------------------------------
# Password for the bundled Postgres container.
POSTGRES_PASSWORD=change-me-to-something-long

# Signs session tokens. Anyone holding this can mint a token for any account.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# --- optional ---------------------------------------------------------------
POSTGRES_USER=misplaceit
POSTGRES_DB=misplaceit

# Host port the web UI is served on.
WEB_PORT=8088

# How long a session lasts, in hours (default one week).
JWT_TTL_HOURS=168

# USDA FoodData Central API key — free from https://fdc.nal.usda.gov/api-key-signup
# Without it, USDA search is skipped and Open Food Facts (which needs no key,
# and is the barcode source) still works.
USDA_API_KEY=

# Set to false once your accounts exist to stop new sign-ups on a public host.
ALLOW_REGISTRATION=true

RUST_LOG=misplace_it=info,tower_http=info,sqlx=warn
